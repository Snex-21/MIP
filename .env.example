# configuración de variables de entorno para el bot de Telegram
BOT_TOKEN=tu_bot_token_aqui
API_ID=tu_api_id_aqui
API_HASH=tu_api_hash_aqui

# motor de sintesis de audio (fluidsynth o soundfont2)
# Ruta absoluta o relativa al SoundFont (.sf2)
SOUNDFONT_PATH=C:\fluidsynth\soundfonts\FluidR3_GM.sf2

# Ruta al ejecutable de FluidSynth (o dejar 'fluidsynth' si está en el PATH)
FLUIDSYNTH_BIN=C:\fluidsynth\bin\fluidsynth.exe

# Tamaño máximo permitido en MB para archivos entrantes
MAX_FILE_SIZE_MB=10
